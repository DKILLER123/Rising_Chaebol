    <dc:title>Peninsula: My Rise to Chaebol Status Began with Ham Eun-jung</dc:title>
    <dc:creator id="creator">The Peninsula Press</dc:creator>
    <meta refines="#creator" property="role" scheme="marc:relators">trl</meta>
